{
  "version": "1.0.0",
  "name": "Story of My League Design Tokens",
  "description": "Three-layer token system (primitive → semantic → component) for consistent UI.",

  "color": {
    "primitive": {
      "green": { "50": "#f0fdf4", "100": "#dcfce7", "500": "#22c55e", "600": "#16a34a", "700": "#15803d", "900": "#05130b" },
      "gray": { "50": "#f9fafb", "100": "#f3f4f6", "600": "#4b5563", "700": "#374151", "800": "#1f2937", "900": "#111827" },
      "slate": { "600": "#475569", "700": "#334155", "800": "#1e293b", "900": "#0f1117" },
      "red": { "500": "#ef4444", "600": "#dc2626", "700": "#b91c1c", "900": "#7c2d12" }
    },
    "semantic": {
      "light": {
        "background": "#f7f8fa",
        "surface": "#ffffff",
        "border": "#e2e4e9",
        "text": "#1a1d24",
        "text-muted": "#6b7280",
        "accent": "#00a05a",
        "accent-text": "#00753f",
        "accent-contrast": "#f7f8fa",
        "error": "#c13136",
        "negative": "#8a4c4e"
      },
      "dark": {
        "background": "#0f1115",
        "surface": "#171a21",
        "border": "#2a2e38",
        "text": "#e8eaed",
        "text-muted": "#8a8f98",
        "accent": "#00c46a",
        "accent-text": "#00c46a",
        "accent-contrast": "#05130b",
        "error": "#e5484d",
        "negative": "#c77477"
      }
    },
    "component": {
      "button": {
        "primary": { "bg": "accent", "text": "accent-contrast", "border": "none" },
        "secondary": { "bg": "transparent", "text": "text", "border": "border" },
        "danger": { "bg": "error", "text": "accent-contrast", "border": "none" }
      },
      "input": {
        "enabled": { "bg": "surface", "text": "text", "border": "border" },
        "focused": { "bg": "surface", "text": "text", "border": "accent", "shadow": "0 0 0 3px rgba(0, 196, 106, 0.25)" },
        "invalid": { "bg": "surface", "text": "text", "border": "error", "shadow": "0 0 0 3px rgba(229, 72, 77, 0.25)" }
      },
      "table": {
        "header": { "bg": "transparent", "text": "text-muted", "size": "11px" },
        "row": { "bg": "transparent", "text": "text", "border": "border" },
        "row-highlight": { "bg": "rgba(0, 196, 106, 0.08)", "text": "text", "border": "border" }
      }
    }
  },

  "typography": {
    "family": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "scale": {
      "h1": { "size": "34px", "weight": 800, "line-height": 1.2 },
      "h2": { "size": "24px", "weight": 700, "line-height": 1.3 },
      "h3": { "size": "20px", "weight": 700, "line-height": 1.4 },
      "body-lg": { "size": "14px", "weight": 400, "line-height": 1.5 },
      "body-sm": { "size": "13px", "weight": 400, "line-height": 1.5 },
      "label": { "size": "11px", "weight": 700, "line-height": 1.2, "transform": "uppercase", "letter-spacing": "0.04em" }
    }
  },

  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "20px",
    "2xl": "24px",
    "3xl": "32px"
  },

  "radius": {
    "control": "8px",
    "card": "12px",
    "pill": "20px",
    "full": "50%"
  },

  "shadow": {
    "none": "none",
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1)"
  },

  "states": {
    "button": {
      "default": "opacity: 1",
      "hover": "opacity: 0.9",
      "active": "opacity: 0.8",
      "disabled": "opacity: 0.5; cursor: not-allowed"
    },
    "input": {
      "enabled": "opacity: 1",
      "hover": "border-color: var(--accent)",
      "focused": "box-shadow: 0 0 0 3px rgba(0, 196, 106, 0.25)",
      "invalid": "border-color: var(--error); box-shadow: 0 0 0 3px rgba(229, 72, 77, 0.25)"
    },
    "focus-ring": "0 0 0 3px rgba(0, 196, 106, 0.25)"
  }
}
